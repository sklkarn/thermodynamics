<?xml version="1.0" encoding="UTF-8"?>

<exercises xml:id="ex_first" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Exercise</title>

 <exercise>
  <p>
          One mole of <m>CH_4</m> at <m>100\,K</m> has a volume of a) <m>8.2 \,L</m> and b) <m>0.5 \,L</m>. 
          Calculate its pressure if it behaves as an ideal gas. Calculate its pressure using van der Waal's gas equation.
          Given: <m>a = 2.25 \, atm\,L^2 /mol^2</m> and <m>b= 0.0428\, L/mol</m>
  </p>
 </exercise>

</exercises>


